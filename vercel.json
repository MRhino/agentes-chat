{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "container",
  "regions": [
    "syd1"
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "command": [
        "sh",
        "-c",
        "SERVER_ROLE=all DATABASE_POOL_MAX=15 DATABASE_URL=\"${DATABASE_URL:-$NEON_DATABASE_URL_UNPOOLED}\" exec bun /app/apps/server/src/main.ts"
      ],
      "instances": {
        "syd1": 0
      },
      "resources": {
        "requests": {
          "memory": "2Gi"
        }
      },
      "terminationGracePeriodSeconds": 120,
      "livenessProbe": {
        "httpGet": {
          "port": 3000,
          "path": "/api/health"
        },
        "initialDelaySeconds": 180,
        "periodSeconds": 30,
        "failureThreshold": 5
      }
    }
  }
}
